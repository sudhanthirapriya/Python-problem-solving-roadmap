# ============================================================================
# Keep These Files (Override rules above if needed)
# ============================================================================

# Force include important files at root
!requirements.txt
!README.md
!CONTRIBUTING.md
!LICENSE
!.gitignore
!GETTING_STARTED.md
!GITHUB_READY_CHECKLIST.md

# Keep all problem files
!**/easy/*.py
!**/medium/*.py
!**/hard/*.py

# Keep real-world projects
!12-real-world-python/**/*.py
!12-real-world-python/**/main.py
VERIFICATION_REPORT.md
upgrade_log.txt
requirements.txt
RENAMING_SUMMARY.md
LICENSE
GETTING_STARTED.md
file_renaming_plan.csv
CONTRIBUTING.md
COMPLETE_FIX_ALL_677.py
COMPLETE_FILE_MAPPING.txt
